    <!-- About -->
    <string name="about_title">Sobre</string>
    <string name="about_body">AI Keyboard usa a API Groq (Llama 3.3) para corrigir e melhorar seu texto. Nenhum dado sai do dispositivo, exceto quando você invoca a IA — aí o texto vai diretamente para api.groq.com via HTTPS.</string>
