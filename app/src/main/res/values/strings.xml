    <string name="settings_haptic_desc">Feedback tátil em cada tecla</string>

    <string name="settings_suggestions_title">Sugestões de palavras</string>
    <string name="settings_suggestions_desc">Mostra até 3 sugestões após uma breve pausa enquanto você digita, incluindo correções locais, próximas palavras, palavras aprendidas e emojis contextuais. Toque para inserir. Long-press salva no seu dicionário pessoal.</string>

