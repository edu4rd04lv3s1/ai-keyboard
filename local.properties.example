# Reference for LOCAL DEVELOPMENT ONLY. Copy this file to local.properties.
# NEVER commit local.properties (it is git-ignored) and NEVER put real secrets here.

# Path to your Android SDK (Android Studio usually writes this automatically).
# Example (macOS Homebrew): /opt/homebrew/share/android-commandlinetools
# Example (default):        /Users/<you>/Library/Android/sdk
sdk.dir=/path/to/your/Android/sdk

# API keys are NOT configured here and are NOT embedded in the build.
# Each user adds their own Groq (and optional Gemini) key inside the app at runtime,
# where it is stored encrypted via EncryptedSharedPreferences.
